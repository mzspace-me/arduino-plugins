{
  "name": "arduino-git-branch-indicator",
  "displayName": "Git Branch Indicator",
  "description": "Shows the checked-out git branch and commit of the open sketch in the Arduino IDE 2 status bar.",
  "version": "0.1.4",
  "publisher": "mzspace",
  "author": {
    "name": "Mz",
    "url": "https://mzspace.me"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.50.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitBranchIndicator.openMenu",
        "title": "Git: Branch Indicator Menu"
      },
      {
        "command": "gitBranchIndicator.showDetails",
        "title": "Git: Show Branch Details"
      }
    ],
    "configuration": {
      "title": "Git Branch Indicator",
      "properties": {
        "gitBranchIndicator.pollIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 300,
          "description": "Seconds between checks for a branch switch or commit made outside the IDE. Checks pause while the IDE is in the background."
        }
      }
    }
  }
}
